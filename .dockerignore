# Secrets - never bake these into an image layer
.env
*.env
!.env.example

# Virtual environments
venv/
.venv/
env/

# Git metadata
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local runtime data (leads/sessions/etc. are runtime state, not image content)
data/raw/
data/*.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs not needed at runtime
README.md
plan.md
