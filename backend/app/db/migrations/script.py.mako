def upgrade() -> None:
    ${upgrades if upgrades else "pass"}
    # Every new table must also get: op.execute("ALTER TABLE <name> ENABLE ROW LEVEL SECURITY")


def downgrade() -> None:
    ${downgrades if downgrades else "pass"}
