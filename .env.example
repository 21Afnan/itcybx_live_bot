# Mistral AI API Key
MISTRAL_API_KEY=

# Pinecone Vector Database API Key & Index Name
PINECONE_API_KEY=
PINECONE_INDEX_NAME=itcybx-kb

# Redis URL for Session Memory (optional; falls back to a local JSON file)
REDIS_URL=redis://localhost:6379/0

# Admin key required to read/delete session transcripts via the API.
# Required in production — these endpoints are locked (503) until this is
# set. Send it as the X-Admin-Api-Key request header.
ADMIN_API_KEY=
