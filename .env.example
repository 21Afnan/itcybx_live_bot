# Copy this file to .env and fill in the real values. Never commit .env.

# development or production. production also runs the website sync once at
# start-up, so a redeploy never brings back older knowledge files.
APP_ENV=development
# The reverse proxies (Nginx, load balancer) in front of the API, comma-separated
# IPs. The visitor's IP is read from X-Forwarded-For only when the request comes
# from one of these; otherwise every visitor looks like the proxy and they all
# share one rate limit. "*" trusts any sender: only use it when the API port
# cannot be reached except through the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Comma-separated. localhost:8080 is for local testing only; remove it in production.
ALLOWED_ORIGINS=https://itcybx.co.uk,http://localhost:8080

# AI models. LLM_PRIMARY = claude or mistral (the other one is the fallback).
# Leave ANTHROPIC_API_KEY empty to use only the Mistral keys.
LLM_PRIMARY=claude
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-5-5
MISTRAL_API_KEY=replace-me
# Extra Mistral keys, comma-separated. Tried in order when the one above is limited.
MISTRAL_API_KEYS=second-key,third-key
MISTRAL_MODEL=mistral-large-latest
LLM_TIMEOUT_SECONDS=20
MAX_OUTPUT_TOKENS=400

# Database (Supabase). In Supabase: Connect -> "Session pooler" -> copy the URI.
# Change the start from "postgresql://" to "postgresql+asyncpg://" and put your
# database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

REDIS_URL=redis://redis:6379/0

# Abuse limits
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=600
MAX_MESSAGE_CHARS=500

# Knowledge sync (weekly, Monday 03:00)
SITE_BASE_URL=https://itcybx.co.uk
SYNC_CRON=0 3 * * 1

# Email (Hostinger SMTP) for lead alerts and sync reports
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@itcybx.co.uk
SMTP_PASSWORD=replace-me
LEAD_EMAIL_TO=info@itcybx.co.uk

# Google Sheet for leads
GOOGLE_SHEET_ID=replace-me
GOOGLE_SERVICE_ACCOUNT_JSON=/code/secrets/google-service-account.json

# Contact buttons
CALENDLY_URL=
WHATSAPP_URL=https://wa.me/923104887999
CONTACT_EMAIL=info@itcybx.co.uk
CONTACT_PAGE_URL=https://itcybx.co.uk/contact/

